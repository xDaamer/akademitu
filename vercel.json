{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**": {
      "includeFiles": "need.json"
    }
  },
  "redirects": [
    { "source": "/portal", "has": [{ "type": "host", "value": "^(www\\.)?akademitu\\.com$" }], "destination": "/login", "permanent": true },
    { "source": "/portal/kayit", "has": [{ "type": "host", "value": "^(www\\.)?akademitu\\.com$" }], "destination": "/login", "permanent": true },
    { "source": "/portal/panel", "has": [{ "type": "host", "value": "^(www\\.)?akademitu\\.com$" }], "destination": "https://portal.akademitu.com/", "permanent": true },
    { "source": "/panel", "has": [{ "type": "host", "value": "^(www\\.)?akademitu\\.com$" }], "destination": "https://portal.akademitu.com/", "permanent": true },

    { "source": "/login", "has": [{ "type": "host", "value": "^portal\\.akademitu\\.com$" }], "destination": "https://www.akademitu.com/login", "permanent": true },
    { "source": "/panel", "has": [{ "type": "host", "value": "^portal\\.akademitu\\.com$" }], "destination": "/", "permanent": true },
    { "source": "/portal", "has": [{ "type": "host", "value": "^portal\\.akademitu\\.com$" }], "destination": "/", "permanent": true },
    { "source": "/portal/:path*", "has": [{ "type": "host", "value": "^portal\\.akademitu\\.com$" }], "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "^portal\\.akademitu\\.com$" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/login",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path]" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
