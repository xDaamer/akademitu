# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase — HEPSİ SUNUCU TARAFI. Hiçbiri VITE_ öneki almaz, yani hiçbiri
# tarayıcı bundle'ına girmez. Frontend Supabase'e doğrudan gitmiyor; her şey
# /api/* üzerinden geçiyor (bkz. server/supabase.ts).
SUPABASE_URL=

# anon/publishable anahtar. ESKİDEN VITE_SUPABASE_ANON_KEY İDİ ve tarayıcıya
# gönderiliyordu. Artık yalnızca burada: kimlik doğrulama çağrıları
# (giriş/kayıt/yenileme) ve kullanıcının kendi jetonuyla yapılan okumalar
# bu anahtarla kuruluyor.
SUPABASE_ANON_KEY=

# RLS'i baypas eder — asla VITE_ öneki almaz, asla istemciye sızmamalı.
# Yalnızca kullanıcıya ait olmayan işler için: lead kaydı, yayınlanmış
# yorumlar, hız limiti sayacı, girişte telefon -> e-posta çevirisi.
SUPABASE_SERVICE_ROLE_KEY=

# İSTEK ATMASINA İZİN VERİLEN TARAYICI ORIGIN'LERİ (virgülle ayrılır).
# Site İKİ HOST'TAN servis ediliyor, o yüzden üçü de listelenmeli: apex, www ve
# panel. Eksik bırakılan bir origin 403 alır ("Geçersiz istek kaynağı").
# Yerel geliştirmede http://localhost:3000 ekleyin.
# Not: bu liste tek başına CSRF koruması DEĞİL — bkz. server/security.ts.
ALLOWED_ORIGINS=https://www.akademitu.com,https://akademitu.com,https://portal.akademitu.com

# OTURUM ÇEREZİNİN ALAN ADI.
# Boş bırakılabilir: sunucu isteğin host'undan türetiyor (*.akademitu.com ise
# ".akademitu.com", localhost/önizleme ise host'a özel). Yalnızca bu türetmeyi
# ezmek gerektiğinde doldurun — örneğin /etc/hosts'a akademitu.local ve
# portal.akademitu.local ekleyip iki host'lu kurulumu yerelde denerken:
#   COOKIE_DOMAIN=.akademitu.local
# YANLIŞ DEĞER OTURUMU TAMAMEN BOZAR: isteğin host'unu kapsamayan bir Domain
# taşıyan çerezi tarayıcı sessizce atar. Bkz. server/cookies.ts.
COOKIE_DOMAIN=

# İSTEMCİ TARAFI ADRES EZMELERİ (yalnızca geliştirme/önizleme).
# Boşsa need.json'daki canlı adresler kullanılır. Yukarıdaki .local kurulumunda:
#   VITE_MAIN_ORIGIN=http://akademitu.local:3000
#   VITE_PORTAL_ORIGIN=http://portal.akademitu.local:3000
# Bunlar SIR DEĞİL (yalnızca alan adı), o yüzden VITE_ öneki sorun değil.
VITE_MAIN_ORIGIN=
VITE_PORTAL_ORIGIN=

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY KALDIRILDI.
# Frontend artık Supabase'e doğrudan gitmiyor ve bundle'da hiçbir Supabase
# anahtarı yok. anon rolünün tablo yetkileri de geri alındı
# (bkz. supabase-portal-auth.sql) — asıl güvenlik kazancı orada.
